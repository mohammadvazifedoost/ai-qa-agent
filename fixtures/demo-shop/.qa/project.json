{
  "name": "demo-shop",
  "packageManager": "npm",
  "typescript": true,
  "framework": "vite",
  "uiLibrary": "react",
  "styling": [
    "css"
  ],
  "designSystem": [],
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173"
  },
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "devPort": 5173,
  "sourceDirs": [
    "src"
  ],
  "componentDirs": [
    "src/components"
  ],
  "routes": [
    {
      "path": "/",
      "file": "src/main.tsx"
    },
    {
      "path": "/checkout",
      "file": "src/main.tsx"
    },
    {
      "path": "/login",
      "file": "src/main.tsx"
    }
  ],
  "routingStyle": "code-router",
  "playwright": {
    "installed": false,
    "configFile": null
  },
  "existingTests": []
}
