{
  "name": "@mohammadvazifedoost/ai-qa-agent",
  "version": "0.3.1",
  "description": "AI QA agent for web apps: Figma + source analysis, Playwright test generation, failure triage, and ClickUp/Jira bug reports.",
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "e2e",
    "ai",
    "figma",
    "accessibility",
    "visual-testing",
    "clickup",
    "jira",
    "claude-code",
    "codex",
    "opencode"
  ],
  "author": "mohammadvazifedoost",
  "license": "MIT",
  "homepage": "https://github.com/mohammadvazifedoost/ai-qa-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadvazifedoost/ai-qa-agent.git"
  },
  "bugs": {
    "url": "https://github.com/mohammadvazifedoost/ai-qa-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ai-qa-agent": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/ui/index.html','dist/ui/index.html')\" && tailwindcss -i src/ui/tailwind.css -o dist/ui/styles.css --minify",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:css": "tailwindcss -i src/ui/tailwind.css -o dist/ui/styles.css --minify"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
